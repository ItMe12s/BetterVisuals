{
	"geode": "5.8.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "imes.bettervisuals",
	"name": "BetterVisuals",
	"version": "v1.2.0",
	"developer": "imes",
	"description": "Neat anti-aliasing and post-processing mod.",
	"tags": [
		"universal",
		"offline",
		"enhancement",
		"customization"
	],
	"links": {
		"community": "https://discord.gg/E8f6D6XqbW",
		"source": "https://github.com/ItMe12s/BetterVisuals"
	},
	"settings": {
		"aa-title": {
			"type": "title",
			"name": "Anti-aliasing"
		},
		"aa-mode": {
			"type": "string",
			"name": "AA Mode",
			"description": "Fullscreen (whole game window) anti-aliasing mode.",
			"default": "SMAA High",
			"one-of": [
				"Off",
				"FXAA",
				"SMAA High",
				"SMAA Ultra"
			]
		},
		"sharpening-title": {
			"type": "title",
			"name": "Sharpening"
		},
		"cas-enabled": {
			"type": "bool",
			"name": "AMD FidelityFX CAS",
			"description": "Apply contrast-adaptive sharpening.",
			"default": false
		},
		"cas-sharpness": {
			"type": "float",
			"name": "CAS Sharpness",
			"description": "Sharpening strength. 0 has less ringing, 1 is strongest.",
			"default": 0.0,
			"min": 0.0,
			"max": 1.0,
			"control": {
				"arrows": true,
				"arrow-step": 0.1,
				"slider": true,
				"slider-step": 0.05
			}
		},
		"fun-title": {
			"type": "title",
			"name": "Fun"
		},
		"bloom-enabled": {
			"type": "bool",
			"name": "Bloom",
			"description": "Apply a mild bloom glow.",
			"default": false
		},
		"grayscale-enabled": {
			"type": "bool",
			"name": "Grayscale",
			"description": "Apply a grayscale filter.",
			"default": false
		},
		"pixelate-enabled": {
			"type": "bool",
			"name": "Pixelate",
			"description": "Apply a pixelated effect.",
			"default": false
		},
		"dithering-enabled": {
			"type": "bool",
			"name": "Dithering Filter",
			"description": "Apply an 8-bit color palette dithering.",
			"default": false
		},
		"vhs-enabled": {
			"type": "bool",
			"name": "VHS Filter",
			"description": "Apply an animated VHS-style filter.",
			"default": false
		},
		"crt-enabled": {
			"type": "bool",
			"name": "CRT Filter",
			"description": "Apply a CRT-style filter.",
			"default": false
		}
	}
}
