{
	"geode": "5.8.2",
	"gd": {
		"win": "2.2081"
	},
	"id": "imes.aa-mod",
	"name": "Anti-aliasing Mod",
	"version": "v1.0.0",
	"developer": "imes",
	"description": "Neat anti-aliasing and post-processing mod.",
	"settings": {
		"aa-title": {
			"type": "title",
			"name": "Anti-aliasing"
		},
		"aa-mode": {
			"type": "string",
			"name": "AA Mode",
			"description": "Fullscreen (game window) anti-aliasing mode.",
			"default": "SMAA High",
			"one-of": [
				"Off",
				"FXAA",
				"SMAA High",
				"SMAA Ultra"
			]
		},
		"sharpening-title": {
			"type": "title",
			"name": "Sharpening"
		},
		"cas-enabled": {
			"type": "bool",
			"name": "AMD FidelityFX CAS",
			"description": "Apply contrast-adaptive sharpening after anti-aliasing.",
			"default": false
		},
		"cas-sharpness": {
			"type": "float",
			"name": "CAS Sharpness",
			"description": "Sharpening strength. 0 has less ringing, 1 is strongest.",
			"default": 0.0,
			"min": 0.0,
			"max": 1.0,
			"control": {
				"arrows": true,
				"arrow-step": 0.1,
				"slider": true,
				"slider-step": 0.05
			}
		},
		"fun-title": {
			"type": "title",
			"name": "Fun"
		},
		"bloom-enabled": {
			"type": "bool",
			"name": "Bloom",
			"description": "Apply a mild bloom glow.",
			"default": false
		},
		"grayscale-enabled": {
			"type": "bool",
			"name": "Grayscale",
			"description": "Convert the display to grayscale.",
			"default": false
		},
		"pixelate-enabled": {
			"type": "bool",
			"name": "Pixelate",
			"description": "Apply a 4-pixel block effect.",
			"default": false
		},
		"dithering-enabled": {
			"type": "bool",
			"name": "Dithering Filter",
			"description": "Apply a RGB332 palette color dithering.",
			"default": false
		},
		"vhs-enabled": {
			"type": "bool",
			"name": "VHS Filter",
			"description": "Apply an animated VHS-style filter.",
			"default": false
		},
		"crt-enabled": {
			"type": "bool",
			"name": "CRT Filter",
			"description": "Apply a CRT-style filter.",
			"default": false
		}
	}
}